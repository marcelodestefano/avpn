        function traduzirEndereco(origAddress, origCountry, origCity) {
          let addr = origAddress || '';

          const paisesMap = {
            'Italia': 'Itália',
            'Giappone': 'Japão',
            'Stati Uniti': 'Estados Unidos',
            'Regno Unito': 'Reino Unido',
            'Francia': 'França',
