<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Planilha Pizza AVPN — Disciplinare Internazionale</title>

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            charcoal: '#141211',
            charcoalCard: '#1E1B18',
            terracotta: '#C84B31',
            gold: '#D4A373',
            cream: '#F8F5F2',
            avpnGreen: '#2D6A4F',
            avpnRed: '#9B2226'
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            serif: ['Playfair Display', 'Georgia', 'serif']
          }
        }
      }
    };
  </script>

  <!-- Estilos customizados e regras de impressão -->
  <style>
    /* Ocultamento estrito de abas inativas */
    .tab-panel {
      display: none !important;
    }
    .tab-panel.active {
      display: block !important;
    }

    /* Scrollbar personalizada dark */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #141211;
    }
    ::-webkit-scrollbar-thumb {
      background: #C84B31;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #D4A373;
    }

    /* Regras de impressão limpa da Ficha Técnica de Bancada */
    @media print {
      body {
        background-color: #ffffff !important;
        color: #000000 !important;
      }
      .no-print {
        display: none !important;
      }
      .print-only {
        display: block !important;
      }
      .tab-panel {
        display: block !important;
        page-break-after: always;
      }
      .bg-charcoal, .bg-charcoalCard {
        background-color: #ffffff !important;
        color: #000000 !important;
        border: 1px solid #ccc !important;
      }
      text, span, h1, h2, h3, h4, td, th, p {
        color: #000000 !important;
      }
    }
  </style>
</head>
<body class="bg-charcoal text-cream font-sans min-h-screen flex flex-col antialiased">

  <!-- ==================== CABEÇALHO DA APLICAÇÃO ==================== -->
  <header class="bg-charcoalCard border-b border-terracotta/30 shadow-xl sticky top-0 z-50 no-print">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        
        <!-- Identidade e Título -->
        <div class="flex items-center space-x-4">
          <div class="w-12 h-12 rounded-full bg-gradient-to-br from-terracotta to-gold flex items-center justify-center shadow-lg font-serif font-bold text-2xl text-charcoal flex-shrink-0">
            🍕
          </div>
          <div>
            <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-cream flex items-center gap-2">
              Planilha Pizza AVPN
              <span class="text-xs font-normal px-2 py-0.5 rounded-full bg-avpnGreen/30 text-green-300 border border-avpnGreen/50">ED. 2026</span>
            </h1>
            <p class="text-xs sm:text-sm text-gold/80 italic">
              Disciplinare Internazionale • Associazione Verace Pizza Napoletana
            </p>
          </div>
        </div>

        <!-- Ferramentas e Contador de Visualizações Híbrido -->
        <div class="flex items-center space-x-3 self-end md:self-auto">
          
          <!-- Badge do Contador com Tooltip -->
          <div class="relative group cursor-pointer bg-charcoal px-3 py-1.5 rounded-lg border border-gold/20 flex items-center space-x-2">
            <svg class="w-4 h-4 text-gold animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            <div class="text-xs">
              <span class="text-gray-400">Acessos:</span>
              <span id="counter-display" class="font-bold text-gold ml-1">---</span>
            </div>
            <!-- Tooltip -->
            <div class="absolute right-0 top-full mt-2 hidden group-hover:block w-64 bg-charcoalCard border border-gold/40 text-xs text-cream p-3 rounded-lg shadow-2xl z-50">
              <p class="font-semibold text-gold mb-1">Estatísticas deste Dispositivo:</p>
              <p id="tooltip-session-visits">Visitas Locais Totais: ---</p>
              <p id="tooltip-last-visit">Última Visita: ---</p>
              <p class="text-[10px] text-gray-400 mt-1 border-t border-gray-700 pt-1">Contador híbrido resiliente com sync remoto.</p>
            </div>
          </div>

          <!-- Botão Imprimir Ficha Técnica -->
          <button onclick="window.print()" class="px-3.5 py-1.5 bg-terracotta hover:bg-terracotta/80 text-cream text-xs sm:text-sm font-semibold rounded-lg shadow transition flex items-center gap-1.5 border border-terracotta/40">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            <span>Imprimir Ficha</span>
          </button>
        </div>

      </div>

      <!-- ==================== BARRA DE NAVEGAÇÃO POR ABAS ==================== -->
      <nav class="mt-4 flex space-x-1 sm:space-x-2 border-b border-gray-700/60 overflow-x-auto pb-1 scrollbar-none" id="tab-navigation">
        
        <button onclick="switchTab('aba1')" data-tab="aba1" class="tab-btn active px-3 sm:px-4 py-2 text-xs sm:text-sm font-medium rounded-t-lg border-b-2 border-terracotta text-terracotta bg-terracotta/10 flex items-center space-x-2 transition whitespace-nowrap">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
          <span>Calculadora de Massa</span>
        </button>

        <button onclick="switchTab('aba2')" data-tab="aba2" class="tab-btn px-3 sm:px-4 py-2 text-xs sm:text-sm font-medium rounded-t-lg border-b-2 border-transparent text-gray-400 hover:text-gold hover:bg-charcoal flex items-center space-x-2 transition whitespace-nowrap">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Cronograma Reverso</span>
        </button>

        <button onclick="switchTab('aba3')" data-tab="aba3" class="tab-btn px-3 sm:px-4 py-2 text-xs sm:text-sm font-medium rounded-t-lg border-b-2 border-transparent text-gray-400 hover:text-gold hover:bg-charcoal flex items-center space-x-2 transition whitespace-nowrap">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/></svg>
          <span>Coberturas & Custos (CMV)</span>
        </button>

        <button onclick="switchTab('aba4')" data-tab="aba4" class="tab-btn px-3 sm:px-4 py-2 text-xs sm:text-sm font-medium rounded-t-lg border-b-2 border-transparent text-gray-400 hover:text-gold hover:bg-charcoal flex items-center space-x-2 transition whitespace-nowrap">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-2V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
          <span>Simulador Peso × Diâmetro</span>
        </button>

        <button onclick="switchTab('aba5')" data-tab="aba5" class="tab-btn px-3 sm:px-4 py-2 text-xs sm:text-sm font-medium rounded-t-lg border-b-2 border-transparent text-gray-400 hover:text-gold hover:bg-charcoal flex items-center space-x-2 transition whitespace-nowrap">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span>Pizzarias AVPN Mundo</span>
        </button>

      </nav>
    </div>
  </header>

  <!-- ==================== CONTEÚDO DAS 5 ABAS ==================== -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- ==================== ABA 1: CALCULADORA DE MASSA AVPN ==================== -->
    <div id="aba1" class="tab-panel active space-y-6">
      
      <!-- Cabeçalho da Seção -->
      <div class="bg-charcoalCard p-6 rounded-xl border border-terracotta/30 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
          <h2 class="text-xl font-bold text-cream flex items-center gap-2">
            <span>Calculadora de Massa Napolitana AVPN</span>
            <span class="text-xs bg-gold/20 text-gold px-2 py-0.5 rounded border border-gold/40">Fórmulas Base Água (100%)</span>
          </h2>
          <p class="text-xs text-gray-400 mt-1">
            Parâmetros estritamente calibrados de acordo com as normas da Associazione Verace Pizza Napoletana.
          </p>
        </div>
        <!-- Badge de Conformidade AVPN -->
        <div id="avpn-status-badge" class="px-4 py-2 rounded-lg bg-avpnGreen/20 border border-avpnGreen text-green-300 text-sm font-semibold flex items-center gap-2">
          <span>✓ Totalmente Conforme AVPN</span>
        </div>
      </div>

      <!-- Grid de Parâmetros e Resumo -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Formulário de Controles (Controles deslizantes + Inputs) -->
        <div class="lg:col-span-7 bg-charcoalCard p-6 rounded-xl border border-gray-800 space-y-5">
          <h3 class="text-base font-semibold text-gold border-b border-gray-800 pb-2">Parâmetros da Produção</h3>

          <!-- Qtd de Pizzas -->
          <div>
            <div class="flex justify-between items-center text-sm mb-1">
              <label for="input-qtd" class="font-medium text-gray-300">Quantidade de Pizzas / Panetti:</label>
              <input type="number" id="input-qtd" value="20" min="1" max="500" class="w-20 bg-charcoal border border-gray-700 rounded px-2 py-1 text-right text-gold font-bold focus:border-terracotta outline-none">
            </div>
            <input type="range" id="slider-qtd" value="20" min="1" max="100" class="w-full accent-terracotta">
          </div>

          <!-- Peso por Panetto -->
          <div>
            <div class="flex justify-between items-center text-sm mb-1">
              <label for="input-peso" class="font-medium text-gray-300">Peso por Boleadora / Panetto (g):</label>
              <div class="flex items-center gap-1">
                <input type="number" id="input-peso" value="200" min="150" max="350" step="1" class="w-20 bg-charcoal border border-gray-700 rounded px-2 py-1 text-right text-gold font-bold focus:border-terracotta outline-none">
                <span class="text-xs text-gray-400">g</span>
              </div>
            </div>
            <input type="range" id="slider-peso" value="200" min="180" max="300" step="1" class="w-full accent-terracotta">
            <p class="text-[11px] text-gray-500 mt-0.5">Faixa AVPN recomendada: 200g a 280g</p>
          </div>

          <!-- Hidratação % -->
          <div>
            <div class="flex justify-between items-center text-sm mb-1">
              <label for="input-hidratacao" class="font-medium text-gray-300">Hidratação (Água / Farinha %):</label>
              <div class="flex items-center gap-1">
                <input type="number" id="input-hidratacao" value="55.0" min="50" max="75" step="0.5" class="w-20 bg-charcoal border border-gray-700 rounded px-2 py-1 text-right text-gold font-bold focus:border-terracotta outline-none">
                <span class="text-xs text-gray-400">%</span>
              </div>
            </div>
            <input type="range" id="slider-hidratacao" value="55.0" min="50" max="70" step="0.5" class="w-full accent-terracotta">
            <p class="text-[11px] text-gray-500 mt-0.5">Faixa AVPN estrita: 55,0% a 62,5%</p>
          </div>

          <!-- Sal Marinho g/L -->
          <div>
            <div class="flex justify-between items-center text-sm mb-1">
              <label for="input-sal" class="font-medium text-gray-300">Sal Marinho Fino (g / Litro de Água):</label>
              <div class="flex items-center gap-1">
                <input type="number" id="input-sal" value="55" min="30" max="80" step="1" class="w-20 bg-charcoal border border-gray-700 rounded px-2 py-1 text-right text-gold font-bold focus:border-terracotta outline-none">
                <span class="text-xs text-gray-400">g/L</span>
              </div>
            </div>
            <input type="range" id="slider-sal" value="55" min="35" max="70" step="1" class="w-full accent-terracotta">
            <p class="text-[11px] text-gray-500 mt-0.5">Faixa AVPN estrita: 40g a 60g por Litro de água</p>
          </div>

          <!-- Fermento Fresco g/L -->
          <div>
            <div class="flex justify-between items-center text-sm mb-1">
              <label for="input-fermento" class="font-medium text-gray-300">Fermento Biológico Fresco (g / L de Água):</label>
              <div class="flex items-center gap-1">
                <input type="number" id="input-fermento" value="0.20" min="0.1" max="5.0" step="0.05" class="w-20 bg-charcoal border border-gray-700 rounded px-2 py-1 text-right text-gold font-bold focus:border-terracotta outline-none">
                <span class="text-xs text-gray-400">g/L</span>
              </div>
            </div>
            <input type="range" id="slider-fermento" value="0.20" min="0.1" max="4.0" step="0.05" class="w-full accent-terracotta">
            <p class="text-[11px] text-gray-500 mt-0.5">Faixa AVPN: 0.1g a 3.0g por Litro de água (ajuste para 12-24h)</p>
          </div>

        </div>

        <!-- Resultados e Receita Consolidada -->
        <div class="lg:col-span-5 flex flex-col justify-between bg-charcoalCard p-6 rounded-xl border border-gray-800 space-y-4">
          <div>
            <h3 class="text-base font-semibold text-gold border-b border-gray-800 pb-2 flex justify-between items-center">
              <span>Receita da Cartela de Bancada</span>
              <span id="res-massa-total-badge" class="text-xs bg-terracotta/20 text-terracotta px-2 py-0.5 rounded border border-terracotta/30">Total: 4.00 kg</span>
            </h3>

            <div class="space-y-3 mt-4">
              <div class="flex justify-between items-center p-2.5 rounded bg-charcoal border border-gray-800">
                <span class="text-sm font-medium text-gray-300">🌾 Farinha Tipo 00 (W280-330):</span>
                <span id="res-farinha" class="font-bold text-lg text-cream">0 g</span>
              </div>
              <div class="flex justify-between items-center p-2.5 rounded bg-charcoal border border-gray-800">
                <span class="text-sm font-medium text-gray-300">💧 Água Potável Fria:</span>
                <span id="res-agua" class="font-bold text-lg text-blue-400">0 ml</span>
              </div>
              <div class="flex justify-between items-center p-2.5 rounded bg-charcoal border border-gray-800">
                <span class="text-sm font-medium text-gray-300">🧂 Sal Marinho Fino:</span>
                <span id="res-sal" class="font-bold text-lg text-gray-200">0 g</span>
              </div>
              <div class="flex justify-between items-center p-2.5 rounded bg-charcoal border border-gray-800">
                <span class="text-sm font-medium text-gray-300">🍞 Fermento Biológico Fresco:</span>
                <span id="res-fermento-fresco" class="font-bold text-lg text-gold">0.00 g</span>
              </div>
              <div class="flex justify-between items-center p-2 rounded bg-charcoal/50 border border-gray-800/80 text-xs">
                <span class="text-gray-400">Alternativa: Fermento Seco Instantâneo (1/3):</span>
                <span id="res-fermento-seco" class="font-semibold text-amber-300">0.00 g</span>
              </div>
            </div>
          </div>

          <!-- Alertas de Validação das Normas AVPN -->
          <div id="avpn-warnings-list" class="text-xs text-amber-300/90 space-y-1 bg-amber-950/20 p-3 rounded border border-amber-900/30">
            <!-- Preenchido dinamicamente se houver violações -->
          </div>
        </div>

      </div>

      <!-- Tabela Dinâmica de Escalonamento de Lotes -->
      <div class="bg-charcoalCard p-6 rounded-xl border border-gray-800 space-y-4 overflow-hidden">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b border-gray-800 pb-3">
          <h3 class="text-base font-semibold text-gold">Tabela Dinâmica de Escalonamento de Massa</h3>
          <p class="text-xs text-gray-400">Proporções instantâneas calculadas para diversos tamanhos de eventos.</p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-charcoal text-gray-400 uppercase font-mono border-b border-gray-700">
              <tr>
                <th class="p-3">Pizzas (Un)</th>
                <th class="p-3">Farinha 00 (g)</th>
                <th class="p-3">Água (ml)</th>
                <th class="p-3">Sal Marinho (g)</th>
                <th class="p-3">Fermento Fresco (g)</th>
                <th class="p-3">Fermento Seco (g)</th>
                <th class="p-3 text-right">Peso Total (kg)</th>
              </tr>
            </thead>
            <tbody id="table-scaling-body" class="divide-y divide-gray-800">
              <!-- Preenchido dinamicamente via JS -->
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- ==================== ABA 2: CRONOGRAMA OPERACIONAL REVERSO ==================== -->
    <div id="aba2" class="tab-panel space-y-6">
      
      <div class="bg-charcoalCard p-6 rounded-xl border border-terracotta/30 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
          <h2 class="text-xl font-bold text-cream">Cronograma Operacional Reverso de Produção</h2>
          <p class="text-xs text-gray-400 mt-1">
            Defina o momento do serviço para calcular exatamente a hora de iniciar a massa, puntata e boleamento.
          </p>
        </div>
        <div class="text-right">
          <span class="text-xs text-gray-400 block">Tempo Total de Fermentação:</span>
          <span id="crono-total-hours" class="text-lg font-bold text-gold">16 Horas Totais</span>
        </div>
      </div>

      <!-- Formulário do Cronograma -->
      <div class="bg-charcoalCard p-6 rounded-xl border border-gray-800 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div>
          <label class="text-xs font-medium text-gray-300 block mb-1">Data do Evento:</label>
          <input type="date" id="crono-date" value="2026-11-08" class="w-full bg-charcoal border border-gray-700 rounded px-3 py-1.5 text-sm text-gold font-bold focus:border-terracotta outline-none">
        </div>
        <div>
          <label class="text-xs font-medium text-gray-300 block mb-1">Horário das Pizzas no Forno:</label>
          <input type="time" id="crono-time" value="19:30" class="w-full bg-charcoal border border-gray-700 rounded px-3 py-1.5 text-sm text-gold font-bold focus:border-terracotta outline-none">
        </div>
        <div>
          <label class="text-xs font-medium text-gray-300 block mb-1">Duração da Puntata (Bloco):</label>
          <select id="crono-puntata" class="w-full bg-charcoal border border-gray-700 rounded px-3 py-1.5 text-sm text-cream focus:border-terracotta outline-none">
            <option value="1">1 hora</option>
            <option value="2" selected>2 horas (Padrão AVPN)</option>
            <option value="4">4 horas</option>
          </select>
        </div>
        <div>
          <label class="text-xs font-medium text-gray-300 block mb-1">Aquecimento do Forno:</label>
          <select id="crono-forno-prep" class="w-full bg-charcoal border border-gray-700 rounded px-3 py-1.5 text-sm text-cream focus:border-terracotta outline-none">
            <option value="60">1h 00m (Gás/Pequeno)</option>
            <option value="90" selected>1h 30m (Lenha Refratário)</option>
            <option value="120">2h 00m (Forno de Grande Porte)</option>
          </select>
        </div>
      </div>

      <!-- Linha do Tempo e Checklist -->
      <div class="bg-charcoalCard p-6 rounded-xl border border-gray-800 space-y-6">
        <div class="flex justify-between items-center border-b border-gray-800 pb-3">
          <h3 class="text-base font-semibold text-gold">Etapas Operacionais em Ordem Cronológica</h3>
          <!-- Barra de Progresso -->
          <div class="flex items-center gap-2">
            <span class="text-xs text-gray-400">Progresso:</span>
            <div class="w-32 bg-charcoal h-3 rounded-full overflow-hidden border border-gray-700">
              <div id="crono-progress-bar" class="bg-terracotta h-full transition-all duration-300" style="width: 0%;"></div>
            </div>
            <span id="crono-progress-text" class="text-xs font-bold text-gold">0%</span>
          </div>
        </div>

        <div id="crono-timeline-container" class="space-y-4">
          <!-- Preenchido dinamicamente com os 6 passos reversos -->
        </div>
      </div>

    </div>

    <!-- ==================== ABA 3: COBERTURAS & CUSTOS (CMV) ==================== -->
    <div id="aba3" class="tab-panel space-y-6">
      
      <div class="bg-charcoalCard p-6 rounded-xl border border-terracotta/30 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
