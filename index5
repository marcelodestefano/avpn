            <circle cx="${cx}" cy="${cy}" r="${innerRadius}" fill="#C84B31" />

            <!-- Textura de Molho -->
            <circle cx="${cx}" cy="${cy}" r="${innerRadius * 0.9}" fill="#B22222" opacity="0.4" />

